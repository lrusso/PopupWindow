{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.2.4",
  "default_locale": "en",
  "homepage_url": "https://github.com/lrusso/PopupWindow",
  "icons": {
    "16": "icon/icon_black-16.png",
    "32": "icon/icon_black-32.png",
    "48": "icon/icon-48.png",
    "128": "icon/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "system.display"
  ],
  "action": {
    "default_title": "__MSG_actionButtonTitle__",
    "default_icon": {
      "16": "icon/icon-16.png",
      "32": "icon/icon-32.png",
      "48": "icon/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "popupWindow": {
      "description": "__MSG_execute__"
    }
  }
}
